{
  "db_path": "gateway.db",
  "cache_ttl_seconds": 86400,
  "max_output_tokens": 4000,
  "models": [
    {
      "alias": "local",
      "provider": "openai_compatible",
      "model": "ministral-3:8b",
      "base_url": "http://localhost:11434/v1",
      "tier": "local",
      "price_input": 0.0,
      "price_output": 0.0,
      "external": false
    },
    {
      "alias": "mistral-fast",
      "provider": "mistral",
      "model": "mistral-small-latest",
      "tier": "fast",
      "price_input": 0.1,
      "price_output": 0.3,
      "external": true
    },
    {
      "alias": "mistral-strong",
      "provider": "mistral",
      "model": "mistral-large-latest",
      "tier": "strong",
      "price_input": 0.5,
      "price_output": 1.5,
      "external": true
    },
    {
      "alias": "local-embed",
      "provider": "openai_compatible",
      "model": "nomic-embed-text",
      "base_url": "http://localhost:11434/v1",
      "kind": "embedding",
      "tier": "embedding",
      "price_input": 0.0,
      "price_output": 0.0,
      "external": false
    }
  ],
  "tier_models": {"local": "local", "fast": "mistral-fast", "strong": "mistral-strong"},
  "fallback_order": ["mistral-strong", "mistral-fast", "local"],
  "embedding_model": "local-embed",
  "teams": [
    {
      "name": "research",
      "key_env": "LLMGW_KEY_RESEARCH",
      "monthly_budget_usd": 50,
      "allowed_models": ["*"],
      "data_policy": "mask_pii",
      "on_budget_exhausted": "degrade"
    },
    {
      "name": "communications",
      "key_env": "LLMGW_KEY_COMMUNICATIONS",
      "monthly_budget_usd": 20,
      "allowed_models": ["local", "mistral-fast"],
      "data_policy": "local_if_pii",
      "on_budget_exhausted": "block"
    },
    {
      "name": "legal",
      "key_env": "LLMGW_KEY_LEGAL",
      "monthly_budget_usd": 0,
      "allowed_models": ["local"],
      "data_policy": "local_only",
      "on_budget_exhausted": "block"
    }
  ]
}
